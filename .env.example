# Production template — copy to .env and fill in the blanks (see DEPLOY.md).
# For local development change APP_ENV=local, APP_DEBUG=true and point
# DB_DATABASE at a COPY of the live database, never the live file itself.

APP_NAME="Inventory Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://example.com

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# The client's data is a single SQLite file. Leave DB_DATABASE unset and it
# resolves to database/database.sqlite; if you move the file outside the
# project tree (recommended on shared hosting), give the absolute path.
DB_CONNECTION=sqlite
#DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site must be served over HTTPS for this to be safe to enable.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# No cache table exists in this database — keep the file store (login
# throttling depends on a working cache store).
CACHE_STORE=file

# Forgot-password emails need a real mailbox. Until these are filled in the
# Forgot Password form tells the user to contact the administrator instead.
# Never use MAIL_MAILER=log on a server: it writes live reset links to the log.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
